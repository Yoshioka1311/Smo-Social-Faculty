{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sh-student-club",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sh-student-club", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sh-student-club-files" }],
  "vars": { "APP_URL": "https://REPLACE_WITH_SITE_HOST", "IG_GRAPH_VERSION": "v24.0", "LOCAL_DEV": "false", "TEMP_STUDENT_ACCESS": "false", "TEMP_ADMIN_ACCESS": "false" },
  "triggers": { "crons": ["*/15 * * * *"] }
}
